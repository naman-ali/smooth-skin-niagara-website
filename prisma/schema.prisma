// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Contact {
  id                           String                 @id @default(auto()) @map("_id") @db.ObjectId
  name                         String
  email                        String
  phone                        String?
  approved                     Boolean                @default(true)
  // Do Not Contact — admin flag meaning this person must not be
  // contacted (marketing, review requests, outreach).
  dnc                          Boolean                @default(false)
  contactType                  String                 @default("client")
  source                       String                 @default("manual")
  imageUrl                     String?
  createdAt                    DateTime               @default(now())
  // AlienRise review-request submission status — admin VISIBILITY ONLY.
  // Records only whether THIS SITE's /review-requests call was successfully
  // submitted (submitted/failed + last error) so failures are visible and
  // retryable. Smooth Skin does not track or decide approval, queueing, or
  // workflow state — AlienRise owns all of that.
  alienriseReviewRequestStatus String? // 'submitted' | 'failed'
  alienriseReviewSubmittedAt   DateTime?
  alienriseReviewRequestError  String?
  clientFormSubmissions        ClientFormSubmission[]
}

model Profile {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @unique
  email     String?
  env       String?
  role      String   @default("user")
  createdAt DateTime @default(now())
}

model ClientFormSubmission {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  formVersion        String
  selectedTreatments String[]
  firstName          String
  lastName           String
  email              String
  phone              String
  /// Full typed ClientFormSubmission payload (client info, treatment
  /// answers, consents, acknowledgement) stored as-is for record keeping.
  submission         Json
  submittedAt        DateTime @default(now())
  createdAt          DateTime @default(now())
  contact            Contact? @relation(fields: [contactId], references: [id])
  contactId          String?  @db.ObjectId
}
