// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Contact {
  id                    String                 @id @default(auto()) @map("_id") @db.ObjectId
  name                  String
  email                 String
  phone                 String?
  approved              Boolean                @default(true)
  contactType           String                 @default("client")
  source                String                 @default("manual")
  imageUrl              String?
  createdAt             DateTime               @default(now())
  clientFormSubmissions ClientFormSubmission[]
}

model Profile {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @unique
  email     String?
  env       String?
  role      String   @default("user")
  createdAt DateTime @default(now())
}

model ClientFormSubmission {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  formVersion        String
  selectedTreatments String[]
  firstName          String
  lastName           String
  email              String
  phone              String
  /// Full typed ClientFormSubmission payload (client info, treatment
  /// answers, consents, acknowledgement) stored as-is for record keeping.
  submission         Json
  submittedAt        DateTime @default(now())
  createdAt          DateTime @default(now())
  contact            Contact? @relation(fields: [contactId], references: [id])
  contactId          String?  @db.ObjectId
}
